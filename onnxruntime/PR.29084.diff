+    // Range(0, Squeeze(Gather(Shape(X), [-1])), 1) == Range(0, 2000, 1) -> 1-D length 2000.
+    EXPECT_TRUE(output_shape.size() == 1) << "Range output should be a 1-D tensor";
+    EXPECT_TRUE(output_shape.size() == 1 && output_shape[0] == 2000)
