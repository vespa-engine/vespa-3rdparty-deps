+bool IsFloat16NodeOnCpuEp(const Node& node, const NodeArg& data_arg) {
+  if (node.GetExecutionProviderType() != kCpuExecutionProvider) {
+    return false;
+  }
+
+  const auto* type_proto = data_arg.TypeAsProto();
+  int32_t element_data_type = 0;
+  return type_proto != nullptr &&
+         utils::TryGetElementDataType(*type_proto, element_data_type) &&
+         element_data_type == ONNX_NAMESPACE::TensorProto_DataType_FLOAT16;
+}
