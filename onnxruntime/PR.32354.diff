@@ -78,7 +88,7 @@ Status Einsum::ComputeInternal(OpKernelContext* context) const {
                                               EinsumOp::DeviceHelpers::CudaDeviceHelpers::ReduceSum<double>,
                                               EinsumOp::DeviceHelpers::CudaDeviceHelpers::DataCopy,
