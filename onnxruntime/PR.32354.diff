   }
+
+  /// As above, but allocated on `stream`. See the matching constructor.
+  static std::unique_ptr<Tensor> Create(MLDataType elt_type, const TensorShape& shape,
+                                        std::shared_ptr<IAllocator> allocator, Stream* stream) {
